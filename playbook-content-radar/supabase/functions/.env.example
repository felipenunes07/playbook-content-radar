# Copy to supabase/functions/.env for local development. Never commit real values.
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=harvestapi/linkedin-post-search
APIFY_LINKEDIN_INPUT_JSON={"authorUrls":["{{accountUrl}}"],"maxPosts":500,"postedLimitDate":"{{since}}","sortBy":"date","profileScraperMode":"short","scrapeReactions":false,"scrapeComments":false}
APIFY_LINKEDIN_MAX_POSTS=500
APIFY_YOUTUBE_ACTOR_ID=streamers/youtube-scraper
APIFY_YOUTUBE_INPUT_JSON={"startUrls":[{"url":"{{accountUrl}}"}],"maxResults":200,"maxResultsShorts":200,"maxResultStreams":0,"oldestPostDate":"{{since}}","sortVideosBy":"NEWEST","downloadSubtitles":false}
APIFY_YOUTUBE_MAX_VIDEOS=200
APIFY_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
APIFY_INSTAGRAM_INPUT_JSON={"directUrls":["{{accountUrl}}"],"resultsType":"posts","resultsLimit":200,"searchLimit":1}
APIFY_INSTAGRAM_MAX_POSTS=200
# LLM principal (OpenAI). Formato OpenAI Chat Completions.
CLASSIFICATION_API_URL=https://api.openai.com/v1/chat/completions
CLASSIFICATION_API_KEY=
CLASSIFICATION_MODEL=gpt-4o-mini
# LLM reserva (Gemini) — usado automaticamente se o principal falhar (quota, billing,
# 5xx, rate limit). Deixe em branco para desativar o fallback e usar só o principal.
CLASSIFICATION_FALLBACK_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
CLASSIFICATION_FALLBACK_API_KEY=
CLASSIFICATION_FALLBACK_MODEL=gemini-2.0-flash
COLLECTOR_SHARED_SECRET=
